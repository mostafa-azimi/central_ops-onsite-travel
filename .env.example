# Public origin for the active deployment. Do not include a trailing slash.
APP_ORIGIN=https://central-ops-travel.aiherolabs.xyz

# Google Calendar API, server-side only
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Private Google Sheet, server-side only
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Google employee and administrator sign-in
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Gmail notification sender
GOOGLE_EMAIL_CLIENT_ID=
GOOGLE_EMAIL_CLIENT_SECRET=
GOOGLE_EMAIL_REFRESH_TOKEN=
GOOGLE_EMAIL_SENDER=mike.azimi@shiphero.com

# Optional. When omitted, every active administrator receives new-request email.
ADMIN_NOTIFICATION_EMAIL=

# Optional read-only Calendar fallback. Authenticated Calendar API is preferred.
CALENDAR_ICS_URL=

# Optional build-time override. Leave blank for same-origin sign-in.
NEXT_PUBLIC_SIGN_IN_ORIGIN=

# Shared secret for the scheduled Calendar reconciliation endpoint.
OPERATIONS_CRON_SECRET=
